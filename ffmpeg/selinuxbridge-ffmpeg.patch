Registers the SELinux Hardware Bridge as real libavcodec codecs --
h264_selinuxbridge and hevc_selinuxbridge, both encoder and decoder -- so
any ffmpeg-driven pipeline can reach Qualcomm Codec2 hardware video from
inside the Termux/PRoot container, where /dev/dma_heap/* is SELinux-denied
and no hardware codec is otherwise available.

These attach to the existing AV_CODEC_ID_H264 / AV_CODEC_ID_HEVC ids
because the bridge speaks standard streams -- unlike the agc1 patch, no new
codec id, descriptor or container tag is needed. ffmpeg's configure derives
its codec list by scanning allcodecs.c for `extern const FFCodec ff_*_encoder;`
and `ff_*_decoder;`, so the declarations below are what makes
--enable-encoder=h264_selinuxbridge and --enable-decoder=h264_selinuxbridge
valid targets.

The configure hunk mirrors what h264_mediacodec already declares: the
decoder only accepts Annex-B, so it pulls in the mp4toannexb bitstream
filter it attaches via FFCodec.bsfs, plus the matching parser.

--- a/libavcodec/allcodecs.c
+++ b/libavcodec/allcodecs.c
@@ -828,6 +828,8 @@
 extern const FFCodec ff_h264_qsv_encoder;
 extern const FFCodec ff_h264_v4l2m2m_encoder;
 extern const FFCodec ff_h264_vaapi_encoder;
+extern const FFCodec ff_h264_selinuxbridge_encoder;
+extern const FFCodec ff_h264_selinuxbridge_decoder;
 extern const FFCodec ff_h264_videotoolbox_encoder;
 extern const FFCodec ff_hevc_amf_encoder;
 extern const FFCodec ff_hevc_cuvid_decoder;
@@ -837,6 +839,8 @@
 extern const FFCodec ff_hevc_qsv_encoder;
 extern const FFCodec ff_hevc_v4l2m2m_encoder;
 extern const FFCodec ff_hevc_vaapi_encoder;
+extern const FFCodec ff_hevc_selinuxbridge_encoder;
+extern const FFCodec ff_hevc_selinuxbridge_decoder;
 extern const FFCodec ff_hevc_videotoolbox_encoder;
 extern const FFCodec ff_libkvazaar_encoder;
 extern const FFCodec ff_mjpeg_cuvid_decoder;
--- a/libavcodec/Makefile
+++ b/libavcodec/Makefile
@@ -399,6 +399,8 @@
 OBJS-$(CONFIG_H264_VIDEOTOOLBOX_ENCODER) += videotoolboxenc.o
 OBJS-$(CONFIG_H264_V4L2M2M_DECODER)    += v4l2_m2m_dec.o
 OBJS-$(CONFIG_H264_V4L2M2M_ENCODER)    += v4l2_m2m_enc.o
+OBJS-$(CONFIG_H264_SELINUXBRIDGE_ENCODER) += selinuxbridge.o
+OBJS-$(CONFIG_H264_SELINUXBRIDGE_DECODER) += selinuxbridge.o
 OBJS-$(CONFIG_HAP_DECODER)             += hapdec.o hap.o
 OBJS-$(CONFIG_HAP_ENCODER)             += hapenc.o hap.o
 OBJS-$(CONFIG_HCA_DECODER)             += hcadec.o
@@ -419,6 +421,8 @@
 OBJS-$(CONFIG_HEVC_VAAPI_ENCODER)      += vaapi_encode_h265.o h265_profile_level.o
 OBJS-$(CONFIG_HEVC_V4L2M2M_DECODER)    += v4l2_m2m_dec.o
 OBJS-$(CONFIG_HEVC_V4L2M2M_ENCODER)    += v4l2_m2m_enc.o
+OBJS-$(CONFIG_HEVC_SELINUXBRIDGE_ENCODER) += selinuxbridge.o
+OBJS-$(CONFIG_HEVC_SELINUXBRIDGE_DECODER) += selinuxbridge.o
 OBJS-$(CONFIG_HEVC_VIDEOTOOLBOX_ENCODER) += videotoolboxenc.o
 OBJS-$(CONFIG_HNM4_VIDEO_DECODER)      += hnm4video.o
 OBJS-$(CONFIG_HQ_HQA_DECODER)          += hq_hqa.o hq_hqadata.o hq_hqadsp.o \
--- a/configure
+++ b/configure
@@ -3176,6 +3176,7 @@
 h264_cuvid_decoder_select="h264_mp4toannexb_bsf"
 h264_mediacodec_decoder_deps="mediacodec"
 h264_mediacodec_decoder_select="h264_mp4toannexb_bsf h264_parser"
+h264_selinuxbridge_decoder_select="h264_mp4toannexb_bsf h264_parser"
 h264_mf_encoder_deps="mediafoundation"
 h264_mmal_decoder_deps="mmal"
 h264_nvenc_encoder_deps="nvenc"
@@ -3194,6 +3195,7 @@
 hevc_cuvid_decoder_select="hevc_mp4toannexb_bsf"
 hevc_mediacodec_decoder_deps="mediacodec"
 hevc_mediacodec_decoder_select="hevc_mp4toannexb_bsf hevc_parser"
+hevc_selinuxbridge_decoder_select="hevc_mp4toannexb_bsf hevc_parser"
 hevc_mf_encoder_deps="mediafoundation"
 hevc_nvenc_encoder_deps="nvenc"
 hevc_nvenc_encoder_select="atsc_a53"
