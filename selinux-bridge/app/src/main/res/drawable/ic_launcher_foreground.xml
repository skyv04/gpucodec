<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground: a chip (hardware codec) with a terminal
  ">_" prompt embedded in its core, symbolising the app's whole purpose:
  a bridge letting a Debian/PRoot terminal shell reach real hardware it
  cannot touch directly. Pins on all four sides echo the same chip motif
  used on the in-app landing screen header for visual consistency.
  Pure vector, no external assets, gradient defined inline via <aapt:attr>.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- chip body -->
    <path android:pathData="M33,33h42v42h-42z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="33" android:startY="33"
                android:endX="75" android:endY="75"
                android:type="linear"
                android:startColor="#22D3EE"
                android:endColor="#A78BFA" />
        </aapt:attr>
    </path>

    <!-- chip core (dark inset) -->
    <path
        android:fillColor="#0B1220"
        android:pathData="M45,45h18v18h-18z" />

    <!-- pins, four sides, two per side -->
    <path
        android:fillColor="#22D3EE"
        android:pathData="M18,40 L33,40 L33,44 L18,44 Z
                           M18,64 L33,64 L33,68 L18,68 Z
                           M75,40 L90,40 L90,44 L75,44 Z
                           M75,64 L90,64 L90,68 L75,68 Z
                           M40,18 L44,18 L44,33 L40,33 Z
                           M64,18 L68,18 L68,33 L64,33 Z
                           M40,75 L44,75 L44,90 L40,90 Z
                           M64,75 L68,75 L68,90 L64,90 Z" />

    <!-- ">" terminal-prompt chevron, inside the core -->
    <path
        android:strokeColor="#4ADE80"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M48,47 L54,54 L48,61" />

    <!-- "_" underscore, completing the ">_" prompt glyph -->
    <path
        android:strokeColor="#4ADE80"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M50,64 L58,64" />

</vector>
