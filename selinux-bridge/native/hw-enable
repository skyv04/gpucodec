#!/usr/bin/env bash
#
# hw-enable -- make the phone's hardware native to every application in this
# container, present and future.
#
# The bridge already reaches the hardware, but until now every consumer had
# to know about it: a special launcher for the GPU, a FIFO path for the
# camera, a hand-picked PulseAudio source for the microphone, a different
# ffmpeg binary for the hardware codecs. That is integration by convention,
# and it only works for applications somebody remembered to wire up.
#
# This installs the same four capabilities where the standard Linux
# interfaces are, so an application that knows nothing about any of this
# finds them by looking in the ordinary places:
#
#   camera  -> /dev/video0, a real V4L2 capture node (native/v4l2-shim.c),
#              listed in /sys/class/video4linux so that libudev-based
#              enumeration finds it (native/sysfs-shim.c, native/netlink-shim.c)
#   mic     -> the default PulseAudio source
#   GPU     -> session-wide for GL (Turnip+Zink), and for Chromium and
#              Electron applications via native/pci-shim.c
#   codecs  -> ffmpeg on PATH is the build that has the bridge encoders
#
# Everything here is idempotent and reversible: `uninstall` puts the machine
# back exactly as it was.
#
# Usage: hw-enable [install|uninstall|status|doctor]
#
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BRIDGE_DIR="$(cd "$HERE/.." && pwd)"
SHIM="$HERE/libv4l2bridge.so"
PCI_SHIM="$HERE/libpcibridge.so"
NL_SHIM="$HERE/libnlbridge.so"
SYSFS_SHIM="$HERE/libsysfsbridge.so"
ALL_SHIMS="$SHIM $PCI_SHIM $NL_SHIM $SYSFS_SHIM"
CLIENT="$BRIDGE_DIR/bridge_client"
STATE_DIR="${BRIDGE_STATE_DIR:-$HOME/.cache/selinux-bridge}"
SYSFS_ROOT="$STATE_DIR/sysfs"

PROFILE_D=/etc/profile.d/20-selinux-bridge-hw.sh
LOCAL_BIN=/usr/local/bin
AUTOSTART_DIR="$HOME/.config/autostart"
AUTOSTART="$AUTOSTART_DIR/selinux-bridge-hw.desktop"
SESSION_HOOK="$HOME/.xprofile"
XFCE_XINITRC="${XDG_CONFIG_HOME:-$HOME/.config}/xfce4/xinitrc"
SYSTEM_XINITRC=/etc/xdg/xfce4/xinitrc
FFMPEG_PREFIX="${FFMPEG_PREFIX:-$HOME/build/ffmpeg-agc1-install}"
MARK_BEGIN="# >>> selinux-bridge hardware >>>"
# Marks a file this script created in its entirety, as opposed to one that
# already existed and merely had a block inserted. Uninstall removes the
# former and edits the latter, and guessing between the two from the file's
# shape is exactly the kind of heuristic that gets it wrong.
MARK_OWNED="# selinux-bridge: this whole file is generated"
MARK_END="# <<< selinux-bridge hardware <<<"

say()  { printf '%s\n' "$*"; }
ok()   { printf '  \033[32mok\033[0m    %s\n' "$*"; }
warn() { printf '  \033[33mwarn\033[0m  %s\n' "$*"; }
bad()  { printf '  \033[31mfail\033[0m  %s\n' "$*"; }

need_build() {
    local missing=0 f
    for f in $ALL_SHIMS; do [ -f "$f" ] || missing=1; done
    if [ "$missing" = 1 ]; then
        say "building the hardware shims..."
        ( cd "$HERE" && make --no-print-directory ) || {
            bad "could not build the shims in $HERE"
            exit 1
        }
    fi
}

# ---------------------------------------------------------------- install ---

write_profile() {
    cat > "$PROFILE_D" <<EOF
$MARK_BEGIN
# Generated by selinux-bridge/native/hw-enable. Do not edit by hand.
#
# Two small libraries are preloaded into every process:
#
#   libv4l2bridge.so  puts the phone's camera on /dev/video0, by interposing
#                     the handful of libc calls a V4L2 application makes.
#                     BRIDGE_V4L2_DISABLE=1 switches it off.
#
#   libpcibridge.so   lets Chromium's GPU process start, by answering the one
#                     unreadable /proc path libpci insists on. Without it any
#                     Chromium- or Electron-based application aborts on launch.
#                     BRIDGE_PCI_DISABLE=1 switches it off.
#
#   libnlbridge.so    hands out a working substitute for the kernel uevent
#                     netlink socket, which this container is not allowed to
#                     open. libudev gives up when that socket fails, and an
#                     application that asked libudev for devices is then told
#                     there are none -- which is why Chromium reported no
#                     camera *and* no microphone.
#                     BRIDGE_NETLINK_DISABLE=1 switches it off.
#
#   libsysfsbridge.so overlays a readable /sys/class/video4linux entry for the
#                     camera. Enumeration reads sysfs, not /dev, so without
#                     this the device list is empty however well /dev/video0
#                     behaves. BRIDGE_SYSFS_DISABLE=1 switches it off.
#
# All four are inert in a process that never touches those paths.

for _bridge_shim in "$SHIM" "$PCI_SHIM" "$NL_SHIM" "$SYSFS_SHIM"; do
    [ -f "\$_bridge_shim" ] || continue
    case ":\${LD_PRELOAD:-}:" in
        *":\$_bridge_shim:"*) ;;
        *) LD_PRELOAD="\${LD_PRELOAD:+\$LD_PRELOAD:}\$_bridge_shim" ;;
    esac
done
unset _bridge_shim
export LD_PRELOAD

# Where the shim and the tools find the bridge client.
export BRIDGE_CLIENT="$CLIENT"

# Where the synthetic sysfs entries live. Only paths that exist underneath
# are redirected; everything else in /sys is read from the real one.
export BRIDGE_SYSFS_ROOT="$SYSFS_ROOT"
$MARK_END
EOF
    chmod 0644 "$PROFILE_D"
    ok "$PROFILE_D"
}

# Applications launched from the desktop inherit the session environment, not
# a login shell's, so the same settings have to reach the X session too.
#
# ~/.xprofile is the conventional place and several display managers read it,
# but `startxfce4` on this system does not: it execs
# $XDG_CONFIG_HOME/xfce4/xinitrc when that exists and /etc/xdg/xfce4/xinitrc
# otherwise, and neither sources .xprofile. Writing only .xprofile therefore
# looks installed and does nothing, which is the failure mode worth avoiding
# -- menu-launched applications would silently miss the camera while a
# terminal-launched one found it. So both are written.
write_session_hook() {
    local tmp
    tmp="$(mktemp)"
    if [ -f "$SESSION_HOOK" ]; then
        sed "/$MARK_BEGIN/,/$MARK_END/d" "$SESSION_HOOK" > "$tmp"
    fi
    cat >> "$tmp" <<EOF
$MARK_BEGIN
# Generated by selinux-bridge/native/hw-enable. Do not edit by hand.
[ -f "$PROFILE_D" ] && . "$PROFILE_D"
$MARK_END
EOF
    mv "$tmp" "$SESSION_HOOK"
    chmod 0644 "$SESSION_HOOK"
    ok "$SESSION_HOOK (display managers that read it)"

    mkdir -p "$(dirname "$XFCE_XINITRC")"
    if [ ! -f "$XFCE_XINITRC" ]; then
        cat > "$XFCE_XINITRC" <<EOF
#!/bin/sh
$MARK_OWNED
$MARK_BEGIN
# Generated by selinux-bridge/native/hw-enable.
#
# startxfce4 execs this file in place of $SYSTEM_XINITRC when it exists, so it is the one place where the whole desktop session -- and
# therefore every application launched from a menu or a panel -- can be given
# the same environment a login shell gets.
[ -f "$PROFILE_D" ] && . "$PROFILE_D"
$MARK_END

# Hand over to the session proper. A wrapper that cannot start the session
# is worse than no wrapper at all -- it is a desktop that does not come up --
# so this does not assume the exec bit survived whatever put the file there.
if [ -x "$SYSTEM_XINITRC" ]; then
    exec "$SYSTEM_XINITRC" "\$@"
else
    exec /bin/sh "$SYSTEM_XINITRC" "\$@"
fi
EOF
        chmod 0755 "$XFCE_XINITRC"
        ok "$XFCE_XINITRC (desktop-launched apps)"
    elif grep -qF "$MARK_BEGIN" "$XFCE_XINITRC"; then
        ok "$XFCE_XINITRC (already hooked)"
    else
        # Someone else's file: insert after the shebang and leave the rest be.
        tmp="$(mktemp)"
        {
            head -1 "$XFCE_XINITRC"
            printf '%s\n' "$MARK_BEGIN" \
                          "# Generated by selinux-bridge/native/hw-enable." \
                          "[ -f \"$PROFILE_D\" ] && . \"$PROFILE_D\"" \
                          "$MARK_END"
            tail -n +2 "$XFCE_XINITRC"
        } > "$tmp"
        cat "$tmp" > "$XFCE_XINITRC"
        rm -f "$tmp"
        ok "$XFCE_XINITRC (hook added to your existing file)"
    fi
}

write_ffmpeg_wrappers() {
    if [ ! -x "$FFMPEG_PREFIX/bin/ffmpeg" ]; then
        warn "no bridge ffmpeg at $FFMPEG_PREFIX -- leaving the system ffmpeg alone"
        return
    fi
    local tool
    for tool in ffmpeg ffprobe ffplay; do
        [ -x "$FFMPEG_PREFIX/bin/$tool" ] || continue
        cat > "$LOCAL_BIN/$tool" <<EOF
#!/bin/sh
# Generated by selinux-bridge/native/hw-enable.
#
# The build behind this wrapper is the stock ffmpeg plus the bridge's own
# encoders and decoders (h264_selinuxbridge, hevc_selinuxbridge), so the
# hardware codecs are reachable from anything that shells out to ffmpeg.
#
# LD_LIBRARY_PATH is set here and not globally on purpose: these shared
# objects must be found by these three binaries and by nothing else, or
# every other application linked against the system libavcodec would be
# silently switched onto a different build of it.
LD_LIBRARY_PATH="$FFMPEG_PREFIX/lib\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH
exec "$FFMPEG_PREFIX/bin/$tool" "\$@"
EOF
        chmod 0755 "$LOCAL_BIN/$tool"
        ok "$LOCAL_BIN/$tool -> bridge build"
    done
}

# The synthetic sysfs entry. libudev, GStreamer and every Chromium-derived
# browser enumerate cameras by walking /sys/class/video4linux and reading
# `name` and `dev` out of each entry -- they never scan /dev -- so without
# this the camera does not appear, no matter how well /dev/video0 answers.
#
# It is generated rather than committed because it has to name this device,
# and because the symlink layout has to match what a real driver produces:
# the class entry is a link into /sys/devices, and each device links back to
# its subsystem. udev follows both, and rejects an entry where they disagree.
write_sysfs_tree() {
    local dev="$SYSFS_ROOT/devices/platform/soc/soc:qcom,cam-req-mgr/video4linux/video0"
    rm -rf "$SYSFS_ROOT"
    mkdir -p "$dev" "$SYSFS_ROOT/class/video4linux" \
             "$SYSFS_ROOT/subsystem/video4linux/devices" "$SYSFS_ROOT/bus"

    printf 'Phone Camera (SELinux Bridge)\n' > "$dev/name"
    printf '81:0\n'                          > "$dev/dev"
    printf '0\n'                             > "$dev/index"
    printf 'MAJOR=81\nMINOR=0\nDEVNAME=video0\n' > "$dev/uevent"

    ln -sfn /sys/class/video4linux "$dev/subsystem"
    ln -sfn "../../devices/platform/soc/soc:qcom,cam-req-mgr/video4linux/video0" \
            "$SYSFS_ROOT/class/video4linux/video0"
    ln -sfn "../../../devices/platform/soc/soc:qcom,cam-req-mgr/video4linux/video0" \
            "$SYSFS_ROOT/subsystem/video4linux/devices/video0"

    ok "$SYSFS_ROOT (camera visible to device enumeration)"
}

write_autostart() {
    mkdir -p "$AUTOSTART_DIR"
    cat > "$AUTOSTART" <<EOF
[Desktop Entry]
Type=Application
Name=SELinux Bridge hardware
Comment=Publishes the phone microphone as the default PulseAudio source
Exec=$HERE/hw-session start
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
EOF
    chmod 0644 "$AUTOSTART"
    ok "$AUTOSTART (microphone at login)"
}

do_install() {
    need_build
    say "installing native hardware access..."
    write_sysfs_tree
    write_profile
    write_session_hook
    write_ffmpeg_wrappers
    write_autostart
    say ""
    say "starting the microphone bridge now..."
    "$HERE/hw-session" start || warn "microphone bridge did not start (see status)"
    say ""
    say "done. Open a new shell, or run:  . $PROFILE_D"
}

# -------------------------------------------------------------- uninstall ---

do_uninstall() {
    say "removing native hardware access..."
    "$HERE/hw-session" stop >/dev/null 2>&1

    rm -f "$PROFILE_D" && ok "removed $PROFILE_D"
    rm -f "$AUTOSTART" && ok "removed $AUTOSTART"

    local tool
    for tool in ffmpeg ffprobe ffplay; do
        if [ -f "$LOCAL_BIN/$tool" ] && grep -q "selinux-bridge" "$LOCAL_BIN/$tool" 2>/dev/null; then
            rm -f "$LOCAL_BIN/$tool" && ok "removed $LOCAL_BIN/$tool"
        fi
    done

    if [ -f "$SESSION_HOOK" ]; then
        local tmp
        tmp="$(mktemp)"
        sed "/$MARK_BEGIN/,/$MARK_END/d" "$SESSION_HOOK" > "$tmp"
        if [ -s "$tmp" ]; then mv "$tmp" "$SESSION_HOOK"; else rm -f "$tmp" "$SESSION_HOOK"; fi
        ok "cleaned $SESSION_HOOK"
    fi

    if [ -f "$XFCE_XINITRC" ] && grep -qF "$MARK_BEGIN" "$XFCE_XINITRC"; then
        # If the file is nothing but our wrapper, remove it so startxfce4
        # goes back to the system one; otherwise just take our block out.
        if grep -qF "$MARK_OWNED" "$XFCE_XINITRC"; then
            rm -f "$XFCE_XINITRC" && ok "removed $XFCE_XINITRC"
        else
            local tmp2
            tmp2="$(mktemp)"
            sed "/$MARK_BEGIN/,/$MARK_END/d" "$XFCE_XINITRC" > "$tmp2"
            cat "$tmp2" > "$XFCE_XINITRC"
            rm -f "$tmp2"
            ok "cleaned $XFCE_XINITRC"
        fi
    fi
    say ""
    say "done. Existing shells still have LD_PRELOAD set; open a new one."
}

# ----------------------------------------------------------------- status ---

do_status() {
    say "native hardware access"
    say ""

    say "camera (/dev/video0):"
    [ -f "$SHIM" ] && ok "shim built: $SHIM" || bad "shim not built"
    [ -f "$PROFILE_D" ] && ok "installed system-wide" || warn "not installed"
    case ":${LD_PRELOAD:-}:" in
        *":$SHIM:"*) ok "active in this shell" ;;
        *) warn "not active in this shell (open a new one)" ;;
    esac

    # A login shell and the desktop session get their environment from
    # different places, and only one of them can be fixed without a restart.
    local spid=""
    for d in /proc/[0-9]*; do
        case "$(cat "$d/comm" 2>/dev/null)" in
            xfce4-session|xfdesktop) spid="${d#/proc/}"; break ;;
        esac
    done
    if [ -n "$spid" ]; then
        if tr '\0' '\n' < "/proc/$spid/environ" 2>/dev/null | grep -q "^LD_PRELOAD=.*libv4l2bridge"; then
            ok "the running desktop session has it (menu-launched apps too)"
        else
            warn "the running desktop session predates this install --"
            warn "  apps launched from the menu will not see the hardware"
            warn "  until you restart the session; new terminals are fine"
        fi
    fi

    say ""
    say "device enumeration (what libudev and browsers read):"
    [ -f "$NL_SHIM" ] && ok "uevent socket shim built" || bad "uevent socket shim not built"
    [ -f "$SYSFS_SHIM" ] && ok "sysfs overlay shim built" || bad "sysfs overlay shim not built"
    if [ -e "$SYSFS_ROOT/class/video4linux/video0/name" ]; then
        ok "sysfs entry: $(cat "$SYSFS_ROOT/class/video4linux/video0/name")"
    else
        warn "no sysfs entry (run: hw-enable install)"
    fi

    say ""
    say "microphone (PulseAudio):"
    "$HERE/hw-session" status 2>&1 | sed 's/^/  /'

    say ""
    say "GPU:"
    local r
    r="$(timeout 60 glxinfo -B 2>/dev/null | sed -n 's/^OpenGL renderer string: //p')"
    case "$r" in
        *Adreno*|*zink*) ok "hardware: $r" ;;
        "")              warn "no GL (no display?)" ;;
        *)               warn "software: $r" ;;
    esac
    [ -f "$PCI_SHIM" ] && ok "Chromium/Electron shim built: $PCI_SHIM" \
                       || bad "Chromium/Electron shim not built"
    case ":${LD_PRELOAD:-}:" in
        *":$PCI_SHIM:"*) ok "Chromium/Electron shim active in this shell" ;;
        *) warn "Chromium/Electron shim not active (open a new shell)" ;;
    esac

    say ""
    say "hardware codecs (ffmpeg on PATH):"
    local ff
    ff="$(command -v ffmpeg 2>/dev/null)"
    if [ -z "$ff" ]; then
        bad "no ffmpeg on PATH"
    elif ffmpeg -hide_banner -encoders 2>/dev/null | grep -q selinuxbridge; then
        ok "$ff has the bridge codecs"
    else
        warn "$ff is the stock build (no bridge codecs)"
    fi
}

# ----------------------------------------------------------------- doctor ---

# Proves each path end to end rather than reporting that a file exists.
do_doctor() {
    local fails=0

    say "checking the bridge..."
    if "$BRIDGE_DIR/tools/bridge-status" >/dev/null 2>&1; then
        ok "bridge reachable on the loopback port"
    else
        bad "bridge unreachable -- is the app running on the phone?"
        fails=$((fails + 1))
    fi

    say ""
    say "checking the camera as an ordinary application sees it..."
    local out
    out="$(LD_PRELOAD="$SHIM" timeout 120 ffmpeg -hide_banner -f v4l2 -i /dev/video0 \
             -frames:v 10 -f null - 2>&1 </dev/null)"
    if printf '%s' "$out" | grep -qE "frame= *10"; then
        ok "captured 10 frames from /dev/video0 ($(printf '%s' "$out" | sed -n 's/.*Video: rawvideo.*, \([0-9]*x[0-9]*\),.*/\1/p' | head -1))"
    else
        bad "could not capture from /dev/video0"
        printf '%s\n' "$out" | tail -3 | sed 's/^/        /'
        fails=$((fails + 1))
    fi

    say ""
    say "checking that the camera is discoverable, not just openable..."
    # Opening /dev/video0 and finding /dev/video0 are different problems.
    # Browsers and GStreamer never scan /dev; they ask libudev, which walks
    # sysfs and needs the uevent netlink socket to initialise at all. This
    # exercises that path exactly as they do.
    local udev
    udev="$(LD_PRELOAD="$NL_SHIM:$SYSFS_SHIM" BRIDGE_SYSFS_ROOT="$SYSFS_ROOT" \
            timeout 60 udevadm info --path=/class/video4linux/video0 2>&1)"
    if printf '%s' "$udev" | grep -q "^N: video0"; then
        ok "libudev resolves video0 as $(printf '%s' "$udev" | sed -n 's/^D: //p') in subsystem $(printf '%s' "$udev" | sed -n 's/^U: //p')"
    else
        bad "libudev cannot see the camera -- browsers will report no devices"
        printf '%s\n' "$udev" | tail -2 | sed 's/^/        /'
        fails=$((fails + 1))
    fi

    # Being able to resolve a path someone hands you is not the same as
    # being able to find the device in the first place, and toolkits do the
    # latter: GStreamer's device provider and gudev scan the subsystem.
    local scan
    scan="$(LD_PRELOAD="$NL_SHIM:$SYSFS_SHIM" BRIDGE_SYSFS_ROOT="$SYSFS_ROOT" \
            timeout 60 udevadm trigger --subsystem-match=video4linux \
                                       --dry-run --verbose 2>&1)"
    if printf '%s' "$scan" | grep -q "/video4linux/video0$"; then
        ok "a subsystem scan discovers it (what GStreamer and gudev do)"
    else
        bad "the camera can be resolved but not discovered by a scan"
        printf '%s\n' "$scan" | tail -2 | sed 's/^/        /'
        fails=$((fails + 1))
    fi

    # A blanket /sys redirect would break the C library itself, so confirm
    # the overlay is additive.
    if [ "$(LD_PRELOAD="$SYSFS_SHIM" BRIDGE_SYSFS_ROOT="$SYSFS_ROOT" \
            cat /sys/devices/system/cpu/online 2>/dev/null)" = \
         "$(cat /sys/devices/system/cpu/online 2>/dev/null)" ]; then
        ok "real sysfs still reads through unchanged"
    else
        bad "the sysfs overlay is shadowing real entries"
        fails=$((fails + 1))
    fi

    say ""
    say "checking the microphone as an ordinary application sees it..."
    local defsrc
    defsrc="$(pactl info 2>/dev/null | sed -n 's/^Default Source: //p')"
    # phone_mic is the remapped source that applications which hide monitors
    # will accept; bridge_mic.monitor is the fallback when the remap fails.
    if [ -n "$defsrc" ] && printf '%s' "$defsrc" | grep -qE 'phone_mic|bridge_mic'; then
        ok "default source is $defsrc"
        rm -f /tmp/hw-doctor-mic.wav
        parec --device="$defsrc" --file-format=wav /tmp/hw-doctor-mic.wav \
              >/dev/null 2>&1 &
        local pp=$!
        sleep 3
        kill "$pp" 2>/dev/null
        wait "$pp" 2>/dev/null
        local sz
        sz=$(stat -c %s /tmp/hw-doctor-mic.wav 2>/dev/null || echo 0)
        if [ "$sz" -gt 10000 ]; then
            ok "recorded $sz bytes of live audio in 3 s"
        else
            warn "recorded only $sz bytes -- the source exists but is not flowing"
            fails=$((fails + 1))
        fi
        rm -f /tmp/hw-doctor-mic.wav
    else
        bad "default source is '${defsrc:-none}', not the phone microphone"
        fails=$((fails + 1))
    fi

    say ""
    say "checking the GPU..."
    local r
    r="$(timeout 60 glxinfo -B 2>/dev/null | sed -n 's/^OpenGL renderer string: //p')"
    case "$r" in
        *Adreno*|*zink*) ok "$r" ;;
        *) bad "not on the GPU: ${r:-no GL}"; fails=$((fails + 1)) ;;
    esac

    # Chromium is checked separately because it fails in its own way: the
    # browser aborts during start-up, before any page loads, so "does GL
    # work" says nothing about whether a browser can run at all.
    if command -v chromium >/dev/null 2>&1; then
        say ""
        say "checking that Chromium-based applications can start..."
        local prof cout
        prof="$(mktemp -d)"
        cout="$(LD_PRELOAD="$PCI_SHIM" timeout 120 chromium --headless=new \
                  --no-sandbox --user-data-dir="$prof" \
                  --dump-dom 'data:text/html,<title>ok</title>' 2>&1 </dev/null)"
        rm -rf "$prof"
        if printf '%s' "$cout" | grep -q "GPU process isn't usable"; then
            bad "Chromium still aborts on start-up"
            fails=$((fails + 1))
        elif printf '%s' "$cout" | grep -q "<title>ok</title>"; then
            ok "Chromium starts and renders a page"
        else
            warn "Chromium did not render as expected"
            printf '%s\n' "$cout" | tail -3 | sed 's/^/        /'
            fails=$((fails + 1))
        fi
    fi

    say ""
    say "checking the hardware codecs..."
    if ffmpeg -hide_banner -encoders 2>/dev/null | grep -q h264_selinuxbridge; then
        ok "h264_selinuxbridge present in $(command -v ffmpeg)"
    else
        bad "ffmpeg on PATH has no bridge codecs"
        fails=$((fails + 1))
    fi

    say ""
    if [ "$fails" = 0 ]; then
        say "all native hardware paths are working."
    else
        say "$fails check(s) failed."
    fi
    return "$fails"
}

case "${1:-status}" in
    install)   do_install ;;
    uninstall) do_uninstall ;;
    status)    do_status ;;
    doctor)    do_doctor ;;
    *) say "usage: hw-enable [install|uninstall|status|doctor]" >&2; exit 2 ;;
esac
