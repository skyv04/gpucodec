#!/bin/sh
# hw-transcode -- transcode an arbitrary video file through the real
# Qualcomm hardware H.264 encoder, via the SELinux Hardware Bridge companion APK.
#
# This exists because the Termux/PRoot shell itself can never reach Codec2
# hardware directly (denied DMA-BUF access, see selinux-bridge/README.md);
# routing through a real installed app is the one confirmed way around
# that. Unlike AGC-1 (this repo's own from-scratch GPU codec, used when you
# want a self-contained non-standard format), this produces bog-standard
# H.264 that any player/tool can read -- the point here is hardware
# offload, not a novel format.
#
# Usage:
#   hw-transcode [-c h264|hevc] [-D] <in> <out.mp4> [width height fps bitrate]
#
# width/height/fps/bitrate default to the source's own, probed via ffprobe.
# -D also decodes on the hardware block, via the h264_selinuxbridge /
# hevc_selinuxbridge libavcodec decoders, making the whole transcode
# hardware end to end. It needs an ffmpeg built with ffmpeg/build-selinuxbridge.sh
# (point $FFMPEG at it) and uses two bridge sessions at once.
set -eu

usage() {
    cat >&2 <<'EOF'
usage: hw-transcode [-c CODEC] [-r RC] [-D] <in> <out.mp4> [width height fps bitrate]

Decodes <in> with ffmpeg, re-encodes the raw frames on-device through the
real Qualcomm hardware encoder (via the SELinux Hardware Bridge app), and remuxes
the result to <out.mp4>.

  -c CODEC   h264 (default) or hevc
  -r RC      cbr (default) | vbr | cq. Leaving rate control unset made
             Codec2 pick VBR, which overshot an explicit bitrate by 25-34%;
             cbr holds it. With cq, <bitrate> is a quality in 1..100.
  -D         decode on the hardware block too (needs \$FFMPEG built with the
             selinuxbridge decoders); makes the transcode hardware end to end

Requires the SELinux Hardware Bridge app (selinux-bridge/) to be installed and
open on-screen. Run bridge-status first if unsure.
EOF
    exit 2
}

codec=h264
rcmode=cbr
hwdec=0
FFMPEG=${FFMPEG:-ffmpeg}
FFPROBE=${FFPROBE:-ffprobe}
while [ $# -gt 0 ]; do
    case ${1:-} in
        -c) [ $# -ge 2 ] || usage; codec=$2; shift 2 ;;
        -r) [ $# -ge 2 ] || usage; rcmode=$2; shift 2 ;;
        -D|--hw-decode) hwdec=1; shift ;;
        *) break ;;
    esac
done

[ $# -ge 2 ] || usage
case $1 in -h|--help) usage ;; esac

case $codec in
    h264) container_fmt=h264 ;;
    hevc|h265) codec=hevc; container_fmt=hevc ;;
    *) echo "hw-transcode: -c must be h264 or hevc (got '$codec')" >&2; exit 2 ;;
esac

case $rcmode in
    cbr|vbr|cq) ;;
    *) echo "hw-transcode: -r must be cbr, vbr or cq (got '$rcmode')" >&2; exit 2 ;;
esac

BIN_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
CLIENT="$BIN_DIR/bridge_client"
[ -x "$CLIENT" ] || { echo "hw-transcode: $CLIENT not found, run ./build.sh first" >&2; exit 2; }

in=$1; out=$2
[ -r "$in" ] || { echo "hw-transcode: $in: cannot read" >&2; exit 1; }

width=${3:-}
height=${4:-}
fps=${5:-}
bitrate=${6:-4000000}

if [ -z "$width" ] || [ -z "$height" ]; then
    dims=$("$FFPROBE" -v error -select_streams v:0 -show_entries stream=width,height \
                    -of csv=p=0 "$in")
    width=${width:-$(echo "$dims" | cut -d, -f1)}
    height=${height:-$(echo "$dims" | cut -d, -f2)}
fi
if [ -z "$fps" ]; then
    fps=$("$FFPROBE" -v error -select_streams v:0 -show_entries stream=r_frame_rate \
                   -of csv=p=0 "$in" | awk -F/ '{ if ($2==0) print 30; else printf "%d", $1/$2 }')
fi

PORT=${BRIDGE_PORT:-7878}
if ! timeout 3 bash -c "echo > /dev/tcp/127.0.0.1/$PORT" 2>/dev/null; then
    echo "hw-transcode: bridge app unreachable, is it open? (see bridge-status)" >&2
    exit 1
fi

DEC_ARGS=
if [ "$hwdec" = 1 ]; then
    src_codec=$("$FFPROBE" -v error -select_streams v:0 \
                   -show_entries stream=codec_name -of csv=p=0 "$in")
    case $src_codec in
        h264|hevc) ;;
        *) echo "hw-transcode: -D needs an H.264 or HEVC source (got '$src_codec')" >&2
           exit 2 ;;
    esac
    if ! "$FFMPEG" -hide_banner -decoders 2>/dev/null | grep -q "${src_codec}_selinuxbridge"; then
        echo "hw-transcode: \$FFMPEG has no ${src_codec}_selinuxbridge decoder." >&2
        echo "              Build one with ffmpeg/build-selinuxbridge.sh." >&2
        exit 2
    fi
    DEC_ARGS="-c:v ${src_codec}_selinuxbridge"
    echo "hw-transcode: decoding with ${src_codec}_selinuxbridge too" >&2
fi

tmp_bs=$(mktemp --suffix=".$container_fmt")
trap 'rm -f "$tmp_bs"' EXIT

echo "hw-transcode: ${width}x${height} @ ${fps}fps, bitrate=${bitrate}, codec=${codec}, rc=${rcmode} -> hardware encoder" >&2

# Piping straight from ffmpeg keeps memory flat regardless of clip length,
# but it also means bridge_client cannot auto-retry a transient stall (stdin
# is not rewindable), so a nonzero exit has to be surfaced rather than
# swallowed by the pipeline.
set +e
"$FFMPEG" -v error $DEC_ARGS -i "$in" -f rawvideo -pix_fmt yuv420p -s "${width}x${height}" -r "$fps" - \
  | "$CLIENT" encode -c "$codec" -r "$rcmode" "$width" "$height" "$fps" "$bitrate" - "$tmp_bs"
rc=$?
set -e
if [ "$rc" -eq 3 ]; then
    echo "hw-transcode: the bridge stalled (app backgrounded?). Bring it to the front and retry." >&2
    exit 3
elif [ "$rc" -ne 0 ]; then
    echo "hw-transcode: hardware encode failed (exit $rc)" >&2
    exit "$rc"
fi

"$FFMPEG" -v error -y -f "$container_fmt" -r "$fps" -i "$tmp_bs" -c copy "$out"
echo "hw-transcode: wrote $out" >&2
