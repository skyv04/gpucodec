#!/usr/bin/env bash
#
# bridge-mic -- present the phone's microphone to this container as a real
# PulseAudio source.
#
# Unlike the camera, this one lands properly. /dev/snd/* is denied here, so
# there is no ALSA device to expose, but PulseAudio is a userspace daemon, so
# a virtual device needs no kernel involvement and no root. Anything that
# uses PulseAudio -- which on this system is everything, including Chromium
# -- then sees an ordinary microphone.
#
# Why a null sink fed by pacat, and not module-pipe-source:
#
#   module-pipe-source is the obvious choice and it is wrong. It has no flow
#   control. When the FIFO happens to be empty at poll time it manufactures
#   silence to keep the source running, then still emits the real samples
#   when they turn up -- so the source produces MORE audio than went in, and
#   the excess grows without bound. Measured here: the bridge delivers
#   48000 samples/s to within 0.8% (14.90 s of audio in 15.02 s of wall
#   clock), but reading it back through module-pipe-source yielded 24.10 s
#   in 20.02 s (1.20x) and 44.30 s in 30.64 s (1.45x). In a video call that
#   is audio sliding ever further behind the picture, which is exactly the
#   lip-sync failure this tool exists to avoid.
#
#   pacat is a real PulseAudio stream client, so the server rate-matches it
#   the way it does any other playback stream: underruns become silence
#   without stealing the stream's place in time. Measured the same way:
#   14.93 s of audio in 15.03 s of wall clock (0.993x), with the audio
#   intact (99.7% non-zero samples, RMS 597 against 557 captured direct).
#
#   The bonus is that the FIFO becomes container-local. pacat speaks the
#   PulseAudio protocol, so only pacat has to read the pipe -- the server
#   never does. The old arrangement needed a path that resolved identically
#   inside this container and inside Termux, and failed with nothing but
#   "Module initialization failed" when it did not.
#
# Usage:
#   bridge-mic [-s SOURCE] [-r RATE] [-c CHANNELS] [start|stop|status]
#
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLIENT="${BRIDGE_CLIENT:-$HERE/../bridge_client}"

# Container-local: only pacat reads this, and pacat runs on this side.
STATE_DIR="${BRIDGE_STATE_DIR:-$HOME/.cache/selinux-bridge}"
FIFO="$STATE_DIR/mic.fifo"

PIDFILE="$STATE_DIR/mic.pid"
MODFILE="$STATE_DIR/mic.module"
REMAPFILE="$STATE_DIR/mic.remap"
LOGFILE="$STATE_DIR/mic.log"

SOURCE=mic
RATE=48000
CHANNELS=1
# The sink is what we create; the monitor of it is what applications record
# from. Naming the sink bridge_mic keeps the recording device bridge_mic.monitor.
SINK_NAME=bridge_mic
MONITOR_NAME="$SINK_NAME.monitor"

# The monitor of the null sink carries the audio perfectly well, but a great
# many applications refuse to show monitor sources at all -- Chromium and
# everything built on it, Zoom, Discord, OBS -- because a monitor is normally
# loopback of the speakers, and offering it as a microphone causes feedback.
# The result is a microphone that works everywhere except in the programs
# people actually make calls with. module-remap-source republishes the same
# stream as an ordinary input device, which those filters accept.
REMAP_NAME=phone_mic
SOURCE_NAME="$REMAP_NAME"
# Small enough not to be felt in a call, large enough to absorb the bursts
# the phone link delivers in.
LATENCY_MS="${BRIDGE_MIC_LATENCY_MS:-50}"

# getopts has no notion of long options, and --help is the first thing
# anyone types, so translate it before the loop rather than exiting 2 on it.
for _a in "$@"; do [ "$_a" = "--help" ] && { sed -n '2,20p' "$0"; exit 0; }; done

while getopts "s:r:c:h" opt; do
    case "$opt" in
        s) SOURCE="$OPTARG" ;;
        r) RATE="$OPTARG" ;;
        c) CHANNELS="$OPTARG" ;;
        h) sed -n '2,20p' "$0"; exit 0 ;;
        *) exit 2 ;;
    esac
done
shift $((OPTIND - 1))
CMD="${1:-start}"

mkdir -p "$STATE_DIR"

running() {
    [ -f "$PIDFILE" ] || return 1
    local p alive=0
    for p in $(cat "$PIDFILE" 2>/dev/null); do
        [ -n "$p" ] && [ -d "/proc/$p" ] && alive=1
    done
    [ "$alive" = 1 ]
}

# Both halves must be up. If only one is, the bridge is not merely degraded
# -- a reader blocks forever on a pipe with no writer, which looks like a
# hang rather than a failure, so treat a half-dead pipeline as dead.
fully_running() {
    [ -f "$PIDFILE" ] || return 1
    local p n=0 alive=0
    for p in $(cat "$PIDFILE" 2>/dev/null); do
        n=$((n + 1))
        [ -d "/proc/$p" ] && alive=$((alive + 1))
    done
    [ "$n" -gt 0 ] && [ "$alive" = "$n" ]
}

unload_module() {
    # Unload the remap before the sink it is derived from, or PulseAudio is
    # briefly left with a source whose master has gone.
    if [ -f "$REMAPFILE" ]; then
        pactl unload-module "$(cat "$REMAPFILE")" 2>/dev/null
        rm -f "$REMAPFILE"
    fi
    if [ -f "$MODFILE" ]; then
        pactl unload-module "$(cat "$MODFILE")" 2>/dev/null
        rm -f "$MODFILE"
    fi
    # Belt and braces: an earlier run that was killed hard leaves the modules
    # loaded with no state file, and loading a second one would give two
    # devices with the same name.
    local idx
    idx=$(pactl list short modules 2>/dev/null \
          | awk -v n="source_name=$REMAP_NAME" '$2=="module-remap-source" && $0 ~ n {print $1}')
    for i in $idx; do pactl unload-module "$i" 2>/dev/null; done
    idx=$(pactl list short modules 2>/dev/null \
          | awk -v n="sink_name=$SINK_NAME" '$2=="module-null-sink" && $0 ~ n {print $1}')
    for i in $idx; do pactl unload-module "$i" 2>/dev/null; done
}

case "$CMD" in
stop)
    if running; then
        for p in $(cat "$PIDFILE" 2>/dev/null); do kill "$p" 2>/dev/null; done
        sleep 0.3
        for p in $(cat "$PIDFILE" 2>/dev/null); do
            [ -d "/proc/$p" ] && kill -9 "$p" 2>/dev/null
        done
    fi
    rm -f "$PIDFILE"
    unload_module
    rm -f "$FIFO"
    echo "microphone bridge stopped"
    exit 0
    ;;
status)
    if fully_running; then
        echo "running (pids $(tr '\n' ' ' <"$PIDFILE"))"
        pactl list short sources 2>/dev/null | grep -E "$SINK_NAME|$REMAP_NAME" || true
        exit 0
    fi
    if running; then
        echo "half-dead: part of the pipeline exited -- run 'stop' then 'start'" >&2
        exit 1
    fi
    echo "not running"
    exit 1
    ;;
start) ;;
*)
    echo "unknown command '$CMD' (want start, stop or status)" >&2
    exit 2
    ;;
esac

if running; then
    echo "already running (pids $(tr '\n' ' ' <"$PIDFILE")); use 'stop' first" >&2
    exit 1
fi

if [ ! -x "$CLIENT" ]; then
    echo "bridge_client not found at $CLIENT -- build it with selinux-bridge/build.sh" >&2
    exit 1
fi

if ! pactl info >/dev/null 2>&1; then
    echo "no reachable PulseAudio server (pactl info failed)" >&2
    exit 1
fi

mkdir -p "$STATE_DIR" 2>/dev/null || {
    echo "cannot create $STATE_DIR" >&2
    exit 1
}

unload_module
rm -f "$FIFO"

# No spaces or parentheses in the description: pactl joins the module
# arguments back into one string and re-splits on whitespace, so a quoted
# value containing a space fails with nothing but "Module initialization
# failed".
MODID=$(pactl load-module module-null-sink \
            sink_name="$SINK_NAME" \
            rate="$RATE" channels="$CHANNELS" \
            sink_properties=device.description=Phone_microphone_bridge 2>&1)
if ! [[ "$MODID" =~ ^[0-9]+$ ]]; then
    echo "failed to create the virtual device: $MODID" >&2
    exit 1
fi
echo "$MODID" > "$MODFILE"

REMAPID=$(pactl load-module module-remap-source \
              source_name="$REMAP_NAME" master="$MONITOR_NAME" \
              source_properties=device.description=Phone_Microphone 2>&1)
if [[ "$REMAPID" =~ ^[0-9]+$ ]]; then
    echo "$REMAPID" > "$REMAPFILE"
else
    # Not fatal: the monitor still carries the audio, so anything that does
    # not filter monitors out keeps working.
    echo "warning: could not publish $REMAP_NAME ($REMAPID);" \
         "falling back to $MONITOR_NAME" >&2
    SOURCE_NAME="$MONITOR_NAME"
fi

mkfifo "$FIFO" || { echo "cannot create $FIFO" >&2; unload_module; exit 1; }

# pacat first: opening a FIFO for reading blocks until a writer appears, and
# opening it for writing blocks until a reader does, so whichever starts
# first simply waits. Starting the reader first means the very first samples
# the phone sends have somewhere to go.
pacat --playback --device="$SINK_NAME" \
      --format=s16le --rate="$RATE" --channels="$CHANNELS" \
      --latency-msec="$LATENCY_MS" \
      --stream-name="phone microphone" \
      <"$FIFO" >>"$LOGFILE" 2>&1 &
PACAT_PID=$!

"$CLIENT" mic -s "$SOURCE" "$RATE" "$CHANNELS" 0 "$FIFO" >>"$LOGFILE" 2>&1 </dev/null &
CLIENT_PID=$!

printf '%s\n%s\n' "$CLIENT_PID" "$PACAT_PID" > "$PIDFILE"

sleep 1
if ! fully_running; then
    echo "microphone feed failed to start; last log lines:" >&2
    tail -5 "$LOGFILE" >&2
    kill "$CLIENT_PID" "$PACAT_PID" 2>/dev/null
    unload_module
    rm -f "$PIDFILE" "$FIFO"
    exit 1
fi

# Make it the default, otherwise getUserMedia({audio:true}) picks whatever
# PulseAudio had as default -- usually a sink monitor, which is silent and
# looks exactly like a broken microphone.
pactl set-default-source "$SOURCE_NAME" >/dev/null 2>&1

cat <<EOF
microphone bridge running
  source:  $SOURCE ($RATE Hz, $CHANNELS ch, s16le)
  pulse:   $SOURCE_NAME (now the default source)
  monitor: $MONITOR_NAME (same audio, hidden from some apps)
  latency: ${LATENCY_MS} ms
  fifo:    $FIFO (container-local)

Check it:
  parec --device=$SOURCE_NAME --file-format=wav /tmp/mic-test.wav
EOF
